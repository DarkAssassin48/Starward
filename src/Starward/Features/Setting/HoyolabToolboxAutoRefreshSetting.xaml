<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Setting.HoyolabToolboxAutoRefreshSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820"
                    Padding="0,0,24,24"
                    HorizontalAlignment="Stretch"
                    Spacing="16">

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="{x:Bind lang:Lang.HoyolabAutoRefresh_Title}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.HoyolabAutoRefresh_Description}"
                       TextWrapping="Wrap" />

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Genshin Impact" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.HoyolabAutoRefresh_GenshinDescription}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboBox_Genshin"
                                  MinWidth="260"
                                  MaxWidth="360"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="1"
                                MinWidth="140"
                                Tag="hk4e"
                                Click="RefreshGame_Click"
                                Content="{x:Bind lang:Lang.HoyolabAutoRefresh_RefreshNow}" />
                    </Grid>
                    <TextBlock x:Name="TextBlock_GenshinStatus"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Honkai: Star Rail" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.HoyolabAutoRefresh_StarRailDescription}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboBox_StarRail"
                                  MinWidth="260"
                                  MaxWidth="360"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="1"
                                MinWidth="140"
                                Tag="hkrpg"
                                Click="RefreshGame_Click"
                                Content="{x:Bind lang:Lang.HoyolabAutoRefresh_RefreshNow}" />
                    </Grid>
                    <TextBlock x:Name="TextBlock_StarRailStatus"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Zenless Zone Zero" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.HoyolabAutoRefresh_ZZZDescription}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboBox_ZZZ"
                                  MinWidth="260"
                                  MaxWidth="360"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="1"
                                MinWidth="140"
                                Tag="nap"
                                Click="RefreshGame_Click"
                                Content="{x:Bind lang:Lang.HoyolabAutoRefresh_RefreshNow}" />
                    </Grid>
                    <TextBlock x:Name="TextBlock_ZZZStatus"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button MinWidth="120"
                        Click="Save_Click"
                        Content="{x:Bind lang:Lang.HoyolabAutoRefresh_Save}"
                        Style="{ThemeResource AccentButtonStyle}" />
                <Button Grid.Column="1"
                        HorizontalAlignment="Left"
                        Click="RefreshAll_Click"
                        Content="{x:Bind lang:Lang.HoyolabAutoRefresh_RefreshAll}" />
            </Grid>

            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.HoyolabAutoRefresh_ScheduleNote}"
                       TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
